<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Note"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="16dp" />

    <!-- Note Title Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Title"
        android:textSize="12sp"
        android:textColor="#2D5A52"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/note_title_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Enter title"
        android:textSize="14sp"
        android:background="@drawable/input_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Category Spinner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category"
        android:textSize="12sp"
        android:textColor="#2D5A52"
        android:textStyle="bold" />
    <Spinner
        android:id="@+id/note_category_spinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Note Content Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Content"
        android:textSize="12sp"
        android:textColor="#2D5A52"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/note_content_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Write your notes here..."
        android:textSize="14sp"
        android:minHeight="150dp"
        android:gravity="top"
        android:background="@drawable/input_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:inputType="textMultiLine"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <!-- Buttons -->
    <Button
        android:id="@+id/save_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Save"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#2D5A52"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/cancel_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cancel"
        android:textColor="#2D5A52"
        android:textSize="15sp"
        android:backgroundTint="#E8F0EF" />

</LinearLayout>